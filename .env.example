# ---------------------------------------------------------------------------
# Aurevia environment configuration
# Copy this file to `.env` and fill in your own values.
# The application starts and runs fine without an API key. Overview,
# Explore and Visualize work without one; only Ask Aurevia needs it.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# --- AI layer (optional) ---------------------------------------------------
# Seconds before an AI request is abandoned.
AUREVIA_LLM_TIMEOUT=45
# Retries the SDK performs for transient failures.
AUREVIA_LLM_MAX_RETRIES=2
# Low temperature: planning is a structured task, not a creative one.
AUREVIA_LLM_TEMPERATURE=0.1
# Cap on the response size, which also caps cost per question.
AUREVIA_LLM_MAX_OUTPUT_TOKENS=1200

# --- Optional tuning -------------------------------------------------------
# These also accept the AUREVIA_ prefix; DATAPILOT_ predates the rename.
# Hard limit for uploaded files, in megabytes.
DATAPILOT_MAX_UPLOAD_MB=200
# Rows read from an uploaded file before sampling kicks in.
DATAPILOT_MAX_ROWS=500000
# Rows shown in the UI preview table.
DATAPILOT_PREVIEW_ROWS=100
# Log level: DEBUG | INFO | WARNING | ERROR
DATAPILOT_LOG_LEVEL=INFO
