# ---------------------------------------------------------------------------
# DataPilot environment configuration
# Copy this file to `.env` and fill in your own values.
# The application starts and runs fine without an API key; only the
# (not-yet-implemented) LLM features require one.
# ---------------------------------------------------------------------------

OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4.1-mini

# --- Optional tuning -------------------------------------------------------
# Hard limit for uploaded files, in megabytes.
DATAPILOT_MAX_UPLOAD_MB=200
# Rows read from an uploaded file before sampling kicks in.
DATAPILOT_MAX_ROWS=500000
# Rows shown in the UI preview table.
DATAPILOT_PREVIEW_ROWS=100
# Log level: DEBUG | INFO | WARNING | ERROR
DATAPILOT_LOG_LEVEL=INFO
